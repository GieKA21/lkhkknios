build/
# Native projects are generated by `expo prebuild` (CNG) and never tracked -
# the iOS CI regenerates ios/ each run, and android/ is built locally. Ignoring
# the whole folders keeps `git status` clean and avoids committing generated code.
/android
/ios
*.ipa
*.apk
.env
.env.local
*.p8
*.p12
*.mobileprovision
.DS_Store
*.log

