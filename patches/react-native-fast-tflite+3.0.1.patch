+  kTfLiteNoQuantization = 0,
+  /// Affine quantization (with support for per-channel quantization).
+  /// Corresponds to TfLiteAffineQuantization.
+  kTfLiteAffineQuantization = 1,
+  /// Blockwise quantization.
