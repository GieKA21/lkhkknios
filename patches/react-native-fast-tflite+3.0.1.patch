+  // menyajikan aset lewat http:// (mode pengembangan). Pada build RILIS
+  // Android, require() sebuah berkas .tflite membuatnya dibundel sebagai
+  // RESOURCE aplikasi dan resolveAssetSource mengembalikan nama resource polos
+  // seperti "assets_models_mobilefacenet" - tanpa protokol, sehingga
+  // URL(path) melempar:
+  //   java.net.MalformedURLException: no protocol: assets_models_mobilefacenet
+  // Akibatnya model pengenalan wajah tidak pernah termuat di APK rilis.
   override fun loadAsset(path: String): Promise<ArrayBuffer> {
     return Promise.async {
-      val bytes = URL(path).readBytes()
+      val bytes = if (path.contains("://")) URL(path).readBytes() else loadBundled(path)
       return@async ArrayBuffer.copy(bytes)
     }
   }
+
+  /** Baca aset yang ikut dibundel ke dalam APK, baik sebagai resource maupun berkas assets. */
+  private fun loadBundled(name: String): ByteArray {
+    val context = NitroModules.applicationContext
+      ?: throw IllegalStateException("Tidak ada application context untuk memuat aset: $name")
+
+    // 1) Resource mentah - jalur yang dipakai Metro untuk aset non-gambar.
+    val resourceName = name.substringAfterLast('/').substringBeforeLast('.')
+    for (type in arrayOf("raw", "drawable")) {
+      val id = context.resources.getIdentifier(resourceName, type, context.packageName)
+      if (id != 0) {
+        return context.resources.openRawResource(id).use { it.readBytes() }
+      }
+    }
+
+    // 2) Berkas biasa di folder assets/.
+    return try {
+      context.assets.open(name).use { it.readBytes() }
+    } catch (e: Exception) {
+      throw IllegalStateException(
+        "Aset tidak ditemukan di APK: $name (resource \"$resourceName\" juga tidak ada)", e
+      )
+    }
